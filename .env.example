# Copy this file to .env.local and fill in values from your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# OpenAI API key is server-only. Never prefix it with NEXT_PUBLIC_ or commit a real key.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-6-luna

# Never expose the Supabase service-role key in NEXT_PUBLIC_* variables.